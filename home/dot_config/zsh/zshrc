#! /bin/zsh
# shellcheck disable=SC1071 # shellcheck doesn't like zsh files

if [ -n "$(echo ${HOME}/.config/shell/*(N))" ]; then
    for rc in ${HOME}/.config/shell/* ; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

if [ -n "$(echo ${HOME}/.config/zsh/zshrc.d/*(N))" ]; then
    for rc in ${HOME}/.config/zsh/zshrc.d/* ; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc

if type complete >/dev/null 2>&1 ; then
  if [ -d "${HOME}/.config/complete/" ]; then
    for rc in ${HOME}/.config/complete/* ; do
        if [ -f "$rc" ]; then
            . "$rc"
        fi
    done
fi
unset rc
fi

if type zellij >/dev/null 2>&1 ; then
    ZELLIJ_AUTO_ATTACH='true'
    ZELLIJ_AUTO_ATTACH_SESSION='turtles'
    if [[ -z "$ZELLIJ" ]]; then
        if [[ "$ZELLIJ_AUTO_ATTACH" == "true" ]]; then
            zellij attach -c "$ZELLIJ_AUTO_ATTACH_SESSION" 
        else
            zellij
        fi

        if [[ "$ZELLIJ_AUTO_EXIT" == "true" ]]; then
            exit
        fi
    fi
fi
